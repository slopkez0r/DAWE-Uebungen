<table>
    <thead>
        <tr>
            <% for(let column of columns){ %>
                <th>
                    <%= column %>
                </th>
                <% } %>
                <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        <% for (const entity of entities) { %>
            <tr>
                <% for(let column of columns){ %>
                    <td>
                        <%= entity[column] %>
                    </td>
                <% } %>
                <td>
                    <div class = "actions">
                        <button hx-get="/api/details-form/<%= model %>/<%= entity.id %>" hx-target="#form-container">
                        Show
                        </button>
                    
                        <button hx-put="/api/edit/<%=model%>/<%= entity.id %>" hx-target="#form-container">
                            Edit
                        </button>

                        <button hx-delete="/api/delete/<%=model%>/<%= entity.id%>" hx-target="closest tr" hx-swap="outerHTML"> <!--ersetze durch leere seite-->
                            Delete
                        </button>
                    </div>
                </td>
            </tr>
            <% } %>
    </tbody>
</table>