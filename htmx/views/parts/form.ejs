<dialog id="recordModal">
    <form 
        id="recordForm"
        <% if(method && actionUrl){ %>
            hx-<%= method%>="<%= actionUrl%>"
            hx-target="#table-container"
        <% } %>>

        <% 
            var title = "";
            switch(method){
                case "put": title = "Update current";
                break;
                case null: title = "Details of";
                break;
                case "post": title = "Create new";
                break;
            }
        %>

        <h1> <%= title%> <%= model%>:</h1>
        <% for(let column of columns.slice(1)){ %>
            <fieldset>
                <label>
                    <%= column %>:
                </label>
                <% if(column == "is_democratic") { %>
                    <input
                        name = "<%= column %>"
                        type = "checkbox"
                        <%= entity[column] == 1 ? 'checked' : '' %>
                        <%= readonly ? 'disabled' : '' %>
                    >
                <% } else { %>
                    <%
                    const value =
                        method == "put" || method == null
                            ? entity[column]
                            : "";
                    %>
                    <input
                        name="<%= column %>"
                        type="text"
                        value="<%=value%>"
                        <%= readonly ? 'readonly' : '' %>
                    >
                <%}%>
            </fieldset>
        <% } %>
        <button type = "button" onclick = recordModal.close()>
            Close
        </button>
        <% if (!readonly) { %>
            <button type="submit" onclick = recordModal.close()> Save </button>
        <% } %>
    </form>
</dialog>

<script>
    document.getElementById("recordModal").showModal();
</script>