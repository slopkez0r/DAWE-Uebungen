<dialog id="recordModal">
    <form 
        id="recordForm"
        hx-<%= method%>="<%= actionUrl%>"
        hx-target="#table-container"
        >
        <h1>Add new <%= model%>:</h1>
        <% for(let column of columns){ %>
            <fieldset>
                <label>
                    <%= column %>:
                </label>
                <% if(column == "is_democratic") { %>
                    <input
                        name = "<%= column %>"
                        type = "checkbox"
                        <%= entity[column] ? 'checked' : '' %>
                        <%= readonly ? 'disabled' : '' %>
                    >
                <% } else { %>
                    <input
                        name="<%= column %>"
                        type="text"
                        value="<%= method == "put" ? entity[column] : '' %>"
                        <%= readonly ? 'readonly' : '' %>
                    >
                <%}%>
            </fieldset>
        <% } %>
        <button type = "button" onclick = recordModal.close()>
            Close
        </button>
        <% if (!readonly) { %>
            <button type="submit"> Save </button>
        <% } %>
    </form>
</dialog>

<script>
    document.getElementById("recordModal").showModal();
</script>