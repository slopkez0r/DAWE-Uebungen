<!DOCTYPE html>
<html>
    <head>
        <title>Dashboard</title>
        <link rel="stylesheet" href="/style.css">
        <script src="https://unpkg.com/htmx.org@2.0.4"></script>
    </head>
    <body>
        <header>Dashboard</header>
        
        <!--navigation-->
        <nav>
            <button
                hx-get="/dashboard/country"
                hx-target="body"> <%#apply changes to%>
                Countries
            </button>

            <button
                hx-get="/dashboard/city"
                hx-target="body">
                Cities
            </button>

            <button
                hx-get="/dashboard/river"
                hx-target="body">
                Rivers
            </button>
        </nav>
        <!--form container-->
        <div id="form-container">
            <% if (entity) { %>
                <%- include("parts/form", {
                    entity: entity,
                    columns: cols,
                    model: model,
                    readonly: readonly
                }) %>
            <% } %>
        </div>
        <!--table container-->
        <div id="table-container">
            <button
                hx-get="/api/create-form/<%= model %>"
                hx-target="#form-container"
                >
                Create New
            </button>
            <%- include("parts/table", {
                entities: entities,
                columns: cols,
                model: model
            })%>
        </div>
    </body>
</html>