<dialog id="recordModal">
    <form 
        id="recordForm"
        hx-put="/api/update/<%= model %>/<%= entity.id %>"
        hx-target="#table-container">
        >
        <% for(let column of columns){ %>
            <fieldset>
                <label>
                    <%= column %>:
                </label>

                <% if(column == "is_democratic") { %>
                    <input
                        name = "<%= column %>"
                        type = "checkbox"
                        <%= entity[column] ? 'checked' : '' %>
                        <%= readonly ? 'disabled' : '' %>
                    >
                <% }else{ %>
                    <input
                        name="<%= column %>"
                        type="text"
                        value="<%= entity[column] ?? '' %>"
                        <%= readonly ? 'readonly' : '' %>
                    >
                <%}%>
            </fieldset>
        <% } %>
        <button type = "button">
            Close
        </button>
        <% if (!readonly) { %>
            <button type="submit"> Save </button>
        <% } %>
    </form>
</dialog>