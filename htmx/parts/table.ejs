<table>
    <thead>
        <tr>
            <% for(let column of columns){ %>
                <th>
                    <%= column %>
                </th>
                < %} %>
                    <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        <% for (const entity of entities) { %>
            <tr>
            <tr>
                <% for(let column of columns){ %>
                    <td>
                        <%= entity[column] %>
                    </td>
                <% } %>
            </tr>
            <td>
                <button hx-get="api/read/<%= model >/<%= entity.id %>" hx-target="#form-container">
                    Show
                </button>
            </td>
            <td>
                <button hx-get="api/edit/<%=model>/<%= entity.id %>" hx-target="#form-container">
                    Edit
                </button>
            </td>
            <td>
                <button hx-get="api/delete/<%=model>/<%= entity.id%>" hx-target="closest tr" hx-swap="outerHTML"> <!--ersetze durch leere seite-->
                    Delete
                </button>
            </td>
            </tr>
            <% } %>
    </tbody>
</table>